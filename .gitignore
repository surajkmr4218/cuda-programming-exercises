# Ignore everything in the repository
*

# Do not ignore directories, so Git can search inside them for files
!*/

# Re-ignore all venv directories at any depth
**/venv/
.venv/

# Allow only .cu, .cuh, .py, .slurm files
!*.cu
!*.cuh
!*.slurm
!*.py
!*.md
!*.txt

# Allow the .gitignore file itself to be tracked
!.gitignore